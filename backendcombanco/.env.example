# ==================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ==================================

APP_NAME=Sistema de Biblioteca API
APP_VERSION=1.0.2
API_ROOT_PATH=

# ==================================
# BANCO DE DADOS
# ==================================

DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/biblioteca

# ==================================
# SEGURANÇA
# ==================================

JWT_SECRET=SUBSTITUIR_POR_CHAVE_SEGURA
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================================
# ADMINISTRADOR INICIAL
# ==================================

CREATE_INITIAL_ADMIN=false
INITIAL_ADMIN_EMAIL=admin@biblioteca.local
INITIAL_ADMIN_PASSWORD=SUBSTITUIR_POR_SENHA_SEGURA

# ==================================
# OUTRAS CONFIGURAÇÕES
# ==================================

CORS_ORIGINS=http://localhost:3000
FINE_PER_DAY=1.00